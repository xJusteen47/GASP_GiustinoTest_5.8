{
  "allow": [
    "Bash(git push origin claude/*)",
    "Bash(git push -u origin claude/*)",
    "Bash(git push --set-upstream origin claude/*)",
    "Bash(git push origin HEAD:claude/*)",
    "Bash(git push -u origin HEAD:claude/*)",
    "PowerShell(git push origin claude/*)",
    "PowerShell(git push -u origin claude/*)",
    "PowerShell(git push --set-upstream origin claude/*)",
    "PowerShell(git push origin HEAD:claude/*)",
    "PowerShell(git push -u origin HEAD:claude/*)"
  ],
  "deny": [
    "Bash(git push*--force*)",
    "Bash(git push*-f *)",
    "Bash(git push* -f)",
    "Bash(git push*--mirror*)",
    "Bash(git push*--delete*)",
    "Bash(git push*--all*)",
    "Bash(git push* +*)",
    "Bash(git push*:+*)",
    "Bash(git push*feature/*)",
    "Bash(git push*main*)",
    "Bash(git push origin :*)",
    "PowerShell(git push*--force*)",
    "PowerShell(git push*-f *)",
    "PowerShell(git push* -f)",
    "PowerShell(git push*--mirror*)",
    "PowerShell(git push*--delete*)",
    "PowerShell(git push*--all*)",
    "PowerShell(git push* +*)",
    "PowerShell(git push*:+*)",
    "PowerShell(git push*feature/*)",
    "PowerShell(git push*main*)",
    "PowerShell(git push origin :*)"
  ]
}
