+// THROWAWAY (M4 H0 spikes): never committed, reverted before the docs commit.
+#include "GASNPPTest/GSTN_SpikeH0.h"
+#include "MoverComponent.h"
+#include "MoverTypes.h"
+#include "NativeGameplayTags.h"
+#include "NetworkPredictionLagCompensation.h"
+#include "GameFramework/Actor.h"
+
+UE_DEFINE_GAMEPLAY_TAG_STATIC(TAG_SpikeFrozen, "Spike.Mover.Frozen");
+
+FGSTN_LayeredMove_Freeze::FGSTN_LayeredMove_Freeze()
+{
+	DurationMs = 500.f;
+	MixMode = EMoveMixMode::OverrideAll;
+}
+
+bool FGSTN_LayeredMove_Freeze::GenerateMove(const FMoverTickStartData& StartState, const FMoverTimeStep& TimeStep, const UMoverComponent* MoverComp, UMoverBlackboard* SimBlackboard, FProposedMove& OutProposedMove)
+{
+	OutProposedMove.MixMode = EMoveMixMode::OverrideAll;
+	OutProposedMove.LinearVelocity = FVector::ZeroVector;
+	OutProposedMove.AngularVelocityDegrees = FVector::ZeroVector;
+	return true;
+}
+
+bool FGSTN_LayeredMove_Freeze::HasGameplayTag(FGameplayTag TagToFind, bool bExactMatch) const
+{
+	const FGameplayTag Tag = TAG_SpikeFrozen.GetTag();
+	return (bExactMatch ? Tag.MatchesTagExact(TagToFind) : Tag.MatchesTag(TagToFind)) || Super::HasGameplayTag(TagToFind, bExactMatch);
+}
+
+FLayeredMoveBase* FGSTN_LayeredMove_Freeze::Clone() const
+{
+	return new FGSTN_LayeredMove_Freeze(*this);
+}
+
+void FGSTN_LayeredMove_Freeze::NetSerialize(FArchive& Ar)
+{
+	Super::NetSerialize(Ar);
+}
+
+UScriptStruct* FGSTN_LayeredMove_Freeze::GetScriptStruct() const
+{
+	return FGSTN_LayeredMove_Freeze::StaticStruct();
+}
+
+bool UGSTN_SpikeH0::QueueFreeze(AActor* Pawn, float DurationMs)
+{
+	UMoverComponent* Mover = Pawn ? Pawn->FindComponentByClass<UMoverComponent>() : nullptr;
+	if (!Mover)
+	{
+		return false;
+	}
+	TSharedPtr<FGSTN_LayeredMove_Freeze> Move = MakeShared<FGSTN_LayeredMove_Freeze>();
+	Move->DurationMs = DurationMs;
+	Mover->QueueLayeredMove(Move);
+	return true;
+}
+
+bool UGSTN_SpikeH0::HasFrozenTag(AActor* Pawn)
+{
+	const UMoverComponent* Mover = Pawn ? Pawn->FindComponentByClass<UMoverComponent>() : nullptr;
+	return Mover && Mover->HasGameplayTag(TAG_SpikeFrozen.GetTag(), true);
+}
+
+FString UGSTN_SpikeH0::MoverInfo(AActor* Pawn)
+{
+	const UMoverComponent* Mover = Pawn ? Pawn->FindComponentByClass<UMoverComponent>() : nullptr;
+	if (!Mover)
+	{
+		return TEXT("(no mover)");
+	}
+	return FString::Printf(TEXT("%s;%.1f,%.1f,%.1f;%d"), *Mover->GetMovementModeName().ToString(), Mover->GetVelocity().X, Mover->GetVelocity().Y, Mover->GetVelocity().Z, HasFrozenTag(Pawn) ? 1 : 0);
+}
+
+bool UGSTN_SpikeH0::AddLagComp(AActor* Pawn)
+{
+	if (!Pawn || Pawn->FindComponentByClass<UNetworkPredictionLagCompensation>())
+	{
+		return false;
+	}
+	UNetworkPredictionLagCompensation* Comp = NewObject<UNetworkPredictionLagCompensation>(Pawn, TEXT("SpikeLagComp"));
+	Pawn->AddInstanceComponent(Comp);
+	Comp->RegisterComponent();
+	return true;
+}
