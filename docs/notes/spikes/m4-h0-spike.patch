+bool UGSTN_CombatSimComponent::Spike_ServerOpenHitstop(int32 Frames)
+{
+	if (!GetOwner() || !GetOwner()->HasAuthority())
+	{
+		return false;
+	}
+	return NetworkPredictionProxy.WriteSyncState<FGSTN_CombatSyncState>([Frames](FGSTN_CombatSyncState& Sync)
+	{
+		const int32 Start = Sync.Core.Input.History.GetLatestFrame() + 1;
+		Sync.Core.HitstopStartFrame = Start;
+		Sync.Core.HitstopEndFrame = Start + Frames;
+	}, "SpikeHitstop") != nullptr;
+}
+
+FString UGSTN_CombatSimComponent::Spike_GetHitstop() const
+{
+	const FGSTN_CombatSyncState* Sync = GetSyncState();
+	if (!Sync)
+	{
+		return TEXT("none");
+	}
+	const int32 Latest = Sync->Core.Input.History.GetLatestFrame();
+	return FString::Printf(TEXT("%d,%d,%d,%d"), Sync->Core.HitstopStartFrame, Sync->Core.HitstopEndFrame, Latest, Sync->Core.IsInHitstop(Latest + 1) ? 1 : 0);
+}
