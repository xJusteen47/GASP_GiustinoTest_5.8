#!/bin/sh
# GSTN git guard (pre-push): allows pushes only to claude/*; blocks main, feature/*, deletes, and force-pushes.
ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
while read local_ref local_sha remote_ref remote_sha; do
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$ROOT/Tools/CI/Test-GitGuard.ps1" -Mode Push -RepoRoot "$ROOT" -TargetRef "$remote_ref" -LocalSha "$local_sha" -RemoteSha "$remote_sha" </dev/null
    rc=$?
    if [ $rc -ne 0 ]; then
        exit $rc
    fi
done
exit 0
