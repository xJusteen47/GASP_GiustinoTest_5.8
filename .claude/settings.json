{
  "$schema": "https://json-schema.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "PowerShell(Stop-Process -Name UnrealEditor*)",
      "PowerShell(Stop-Process -Name UnrealEditor-Cmd*)",
      "PowerShell(Get-Process*)",
      "PowerShell(Start-Process*UnrealEditor*)",
      "PowerShell(& *UnrealEditor-Cmd.exe*)",
      "PowerShell(& *UnrealEditor.exe*)",
      "PowerShell(& *Build.bat*)",
      "PowerShell(& *RunUAT.bat*)",
      "PowerShell(powershell -File Tools/*)",
      "PowerShell(powershell -File Saved/*)",
      "PowerShell(& .\\Tools\\*)",
      "PowerShell(Get-Content*)",
      "PowerShell(Get-ChildItem*)",
      "PowerShell(Select-String*)",
      "PowerShell(Test-Path*)",
      "Bash(UnrealEditor-Cmd.exe*)",
      "Bash(*Build.bat*)",
      "Bash(python Tools/*)",
      "Bash(python3 Tools/*)",
      "Bash(py Tools/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git fetch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push origin feature/gas-npp-5.8)",
      "Bash(git push -u origin feature/gas-npp-5.8)",
      "Bash(git pull --rebase origin feature/gas-npp-5.8)",
      "Read(Saved/Logs/**)",
      "Read(Saved/**)",
      "Read(Tools/**)",
      "Read(docs/**)"
    ],
    "deny": [
      "PowerShell(Remove-Item*)",
      "PowerShell(rm *)",
      "PowerShell(del *)",
      "PowerShell(rmdir*)",
      "PowerShell(Stop-Process -Name *explorer*)",
      "PowerShell(taskkill*)",
      "PowerShell(reg *)",
      "PowerShell(*HKLM:*)",
      "PowerShell(*HKCU:*)",
      "PowerShell(Set-ItemProperty*)",
      "Bash(rm *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(git branch -d*)",
      "Bash(git push origin --delete*)",
      "Bash(git push origin :*)"
    ]
  }
}
