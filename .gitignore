ue-mcp.local.yml

# Unreal generated / build output
Binaries/
Intermediate/
DerivedDataCache/
Saved/
Plugins/*/Binaries/
Plugins/*/Intermediate/

# Content: only the project's own folders are versioned (through Git LFS, see .gitattributes).
# The rest is sample content (GASP, MetaHumans, audio...): about 5 GB, not versioned.
Content/*
!Content/Blueprints/
!Content/GAS/
!Content/GASNPPTest/
!Content/Input/
!Content/Levels/
Plugins/*/Content/

# IDE / solution files (regenerated from the .uproject)
.vs/
.idea/
*.sln
*.slnx
*.VC.db
*.opensdf
*.sdf
*.suo

# Local Claude Code settings and tooling
.claude/*
!.claude/skills/

# Nested plugin folders (Plugins/GASNPP/*, Plugins/EngineOverrides/*)
Plugins/**/Binaries/
Plugins/**/Intermediate/
Plugins/**/Content/

__pycache__/

# GSTN plugins whose Content is project-owned (the standard combat rules asset); the rule above is for engine-level plugin copies
!Plugins/GSTNCombat/Content/
!Plugins/GSTNParts/Content/
